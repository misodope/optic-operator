{
  "name": "optic-operator",
  "productName": "Optic Operator",
  "version": "0.1.0",
  "description": "AI-powered camera operator for smooth vertical short-form video.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
