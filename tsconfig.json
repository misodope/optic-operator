{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@app/*": ["src/app/*"],
      "@lib/*": ["src/lib/*"],
      "@store/*": ["src/store/*"],
      "@electron/*": ["src/electron/*"],
      "@shared-types/*": ["src/types/*"]
    }
  },
  "include": ["src", "forge.config.ts", "forge.env.d.ts", "vite.*.config.ts"]
}
